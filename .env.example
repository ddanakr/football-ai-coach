# Copy to .env (ignored by git) and fill in the values. Never commit .env.
# Priority: CLI flag > environment variable > this file > default. An empty value = not set.
# Only these twelve settings live here; thresholds, windows, limits and prices are in the code.

# Which provider the agent and the speech test call: openrouter (paid, the default) or gemini
# (the direct free tier of the Gemini API). The --provider flag of the commands wins.
AICOACH_LLM_PROVIDER=

# OpenRouter API key, needed for the provider openrouter (paid requests go through it).
OPENROUTER_API_KEY=

# The ceiling of paid spending per UTC calendar month, US dollars (for example 3 or 10.5). A request
# that would pass it is not sent. Empty = no ceiling. Every paid request is written to
# spend_ledger.jsonl in AICOACH_DATA_ROOT (or above the match directory).
AICOACH_BUDGET_USD=

# Agent model for the provider openrouter (an OpenRouter slug such as openai/gpt-6-luna). Empty =
# the default from config.py. The --model flag of agent-eval wins. For the provider gemini use
# GEMINI_MODEL.
AICOACH_AGENT_MODEL=

# Video model of the episode description (the "Describe the episode" button, the describe_episode
# tool, the describe command): an OpenRouter slug of a model that accepts video input, for example
# google/gemini-3.7-flash. Empty = the default from config.py. It always goes through OpenRouter.
AICOACH_VLM_MODEL=

# Gemini API key, needed only for the provider gemini (the free tier; such requests cost 0).
GEMINI_API_KEY=

# Gemini model of the agent, only for the provider gemini. Empty = the default from config.py (a
# Flash-lite model with a free tier; see the model list in the Gemini API docs).
GEMINI_MODEL=

# Gemini model of the speech transcription test. Empty = the default from config.py
# (gemini-3.5-transcribe, a speech-to-text model with a free tier).
GEMINI_TRANSCRIBE_MODEL=

# Directory with one directory per match: the default of --data-root (ingest, ui).
AICOACH_DATA_ROOT=

# Path to tesseract.exe, if it is not in PATH. Empty = PATH, then
# C:\Program Files\Tesseract-OCR and C:\Program Files (x86)\Tesseract-OCR.
TESSERACT_CMD=

# Font file (.ttf) of the captions of a reel ("Goal 5'" at the start of each piece). It must have
# the Cyrillic letters. Empty = a search in the usual places (Windows Fonts, DejaVu); no font found
# means a reel without captions and a warning.
AICOACH_FONT_FILE=

# Where the tdeed command keeps the T-DEED code, its checkpoint and the model inputs (outside the
# repository: T-DEED is GPL code). Empty = ~/.cache/aicoach/tdeed. The --cache-dir flag wins.
TDEED_CACHE_DIR=
